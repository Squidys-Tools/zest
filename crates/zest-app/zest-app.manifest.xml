<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Common Controls v6 is required, not cosmetic: gpui's Windows window code
    calls TaskDialogIndirect, which only exists in comctl32 v6. Without this
    dependency the loader resolves comctl32 v5 and zest.exe fails to start with
    "Entry Point Not Found".

    Deliberately no dpiAware / dpiAwareness here. The overlay's geometry is
    hand-rolled in pixels and its window is never resized, so PerMonitorV2 would
    change how the ring looks on scaled displays. DPI awareness belongs to
    SQU-54, which owns the whole process-wide decision.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df" />
    </dependentAssembly>
  </dependency>
</assembly>
